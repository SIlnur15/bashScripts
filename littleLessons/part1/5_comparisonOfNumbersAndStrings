#!/usr/bin/bash

# флаги (их 6) для СРАВНЕНИЯ ЧИСЕЛ:
# -eq, -ge, -gt, -le, -lt, -ne
# сравнение происходит между [ и ], МЕЖДУ НИМИ ОБЯЗАТЕЛЬНО ПРОБЕЛЫ:
value=25
if [ $value -lt 15 ]
then echo "that's true"
else echo "that's not true"
fi

# при СРАВНЕНИИ СТРОК использовать ТОЛЬКО двойные квадратные скобки (это по-современному и безопасно)
# для сравнения строк, флаги используемые при сравнении чисел не используются, а используются следующие
# операторы: >, <, = (также ==), != (т. о. образом НЕТ <= и >=), для их реализации используют оператор ИЛИ || :
# [[ $str1 > $str2 || $str1=$str2 ]]
# -n str1 флаг возвращает истину, если длина str1 больше нуля
# -z str1 флаг возвращает истину, если длина str1 равна нулю

str1="kek"
str2="dek"
if [[ $str1 > $str2 ]] # не забываю про $, между оператором должны быть пробелы, иначе bash решит, что
# речь идет об одной целой строке
then echo "kek is bigger than dek"
else echo "that's not true"
fi

if [[ "aek" > "sek" || "aek" = "aek" ]] # an example with operator OR
then echo "one of statements is true"
else
echo "that's not true"
fi

# для примеров с флагами -n и -z сначала объяснение от ИИ, о некоторых тонкостях работы с текстом в bash:
# Разберу length=${#str}
# $ — говорит интерпретатору Bash: «Внимание, сейчас я буду считывать значение переменной».
# { } — ФИГУРНЫЕ СКОБКИ открывают доступ к специальным встроенным операторам Bash ДЛЯ РАБОТЫ С ТЕКСТОМ.
# # — это и есть ключевой внутренний оператор для определения длины. Если поставить знак решетки сразу после открывающей
# фигурной скобки перед именем переменной, Bash понимает это как команду: «Не выводи саму строку, а посчитай количество
# символов в ней».
# str — имя вашей переменной.

lenOfStr1=${#str1}
if [[ -n $str1 ]]
then echo "it's true because of the length of str1 is $lenOfStr1"
fi
str3=""
lenOfEmptyStr=${#str3}
if [[ -z $str3 ]]
then echo "it's true because the length of str3 is $lenOfEmptyStr"
fi

# есть немаловажный факт, в командах сравнения строк прописные буквы меньше строчных, поэтому сравнение строк здесь
# выполняется путём сравнения ASCII-кодов символов (код A (65) меньше кода a (97)), порядок сортировки, таким образом,
# зависит от кодов символов:

str4="Haidaric"
str5="haidaric"
if [[ $str4 > $str5 ]]
then
echo "that's true becouse of it's strange string's comparison rules"
fi

