#!/usr/bin/bash

# флаги (их 6) для СРАВНЕНИЯ ЧИСЕЛ:
# -eq, -ge, -gt, -le, -lt, -ne
# сравнение происходит между [ и ], МЕЖДУ НИМИ ОБЯЗАТЕЛЬНО ПРОБЕЛЫ:
value=25
if [ $value -lt 15 ]
then echo "that's true"
else echo "that's not true"
fi

# при сравнении строк нужно помнить о приколах с локалью
# при СРАВНЕНИИ СТРОК использовать ТОЛЬКО двойные квадратные скобки (это по-современному и безопасно)
# для сравнения строк, флаги используемые при сравнении чисел не используются, а используются следующие
# операторы: >, <, = (также ==), != (т. о. образом НЕТ <= и >=), для их реализации используют оператор ИЛИ || :
# [[ $str1 > $str2 || $str1=$str2 ]]
# && - оператор И (AND)
# "-n" str1 флаг возвращает истину, если длина str1 больше нуля
# -z str1 флаг возвращает истину, если длина str1 равна нулю

str1="kek"
str2="dek"
if [[ $str1 > $str2 ]] # не забываю про $, между оператором должны быть пробелы, иначе bash решит, что
# речь идет об одной целой строке
then echo "kek is bigger than dek"
else echo "that's not true"
fi

if [[ "aek" > "sek" || "aek" = "aek" ]] # an example with operator OR
then echo "one of statements is true"
else
echo "that's not true"
fi

# для примеров с флагами -n и -z сначала объяснение от ИИ, о некоторых тонкостях работы с текстом в bash:
# Разберу length=${#str}
# $ — говорит интерпретатору Bash: «Внимание, сейчас я буду считывать значение переменной».
# { } — ФИГУРНЫЕ СКОБКИ открывают доступ к специальным встроенным операторам Bash ДЛЯ РАБОТЫ С ТЕКСТОМ.
# # — это и есть ключевой внутренний оператор для определения длины. Если поставить знак решетки сразу после открывающей
# фигурной скобки перед именем переменной, Bash понимает это как команду: «Не выводи саму строку, а посчитай количество
# символов в ней».
# str — имя вашей переменной.

lenOfStr1=${#str1}
if [[ -n $str1 ]]
then echo "it's true because of the length of str1 is $lenOfStr1"
fi
str3=""
lenOfEmptyStr=${#str3}
if [[ -z $str3 ]]
then echo "it's true because the length of str3 is $lenOfEmptyStr"
fi

# есть немаловажный факт (впрочем, неподтвержденный дальнейшими фактами), в командах сравнения строк прописные (большие) буквы меньше строчных (маленьких), поэтому сравнение строк
# выполняется путём сравнения ASCII-кодов символов (код A (65) меньше кода a (97)), порядок сортировки, таким образом, зависит от кодов символов:

str4="Haidaric"
str5="haidaric"
if [[ "$str4" > "$str5" ]]
then
echo "that's true becouse of it's strange string's comparison rules"
fi
# вывод противоречит теории, подобная история служит источником "тихих багов", когда на моем ноуте все норм, в у других людей наоборот.
# ИИ: Ты получаешь that's true из‑за лексикографического сравнения с учётом регистра: да, по теории, в ASCII заглавные буквы идут перед
# строчными, поэтому "H" (код 72) считается «меньше», чем "h" (код 104). Но у тебя условие [[ $str4 > $str5 ]], и оно всё равно даёт true?
# Тут есть важный подвох: в Bash внутри [[ ... ]] сравнение строк по > использует текущую локаль (locale), а не «чистый» ASCII. В типичной
# локали вроде en_US.UTF‑8 правила сортировки могут быть «человекоориентированными»: они стараются сравнивать «по смыслу», игнорируя регистр
# на первом шаге, и тогда "Haidaric" и "haidaric" могут считаться «равными» или идти по алфавиту не так, как в таблице ASCII.
# Не полагайся на интуицию: лексикографический порядок зависит от локали. Чтобы сделать поведение предсказуемым, можно временно выставить LC_COLLATE=C:
# В C locale сравнение идёт строго по байтовым кодам: заглавные < строчные, и всё становится прозрачным.
# Такие «странные» сравнения легко становятся источником тихих багов: скрипт работает у тебя, а на другом сервере или в CI — ломается, потому что там другая локаль.
# Прикольно в общем

str6="h"
str7="H"
if [[ str6 > str7 ]]
then
echo "h > H"
else echo "keep going"
fi
# Консольная команда sort, в свою очередь, использует порядок сортировки, заданный в настройках системного языка, т. е. в привычном порядке - прописные (большие) больше строчных (маленьких)
